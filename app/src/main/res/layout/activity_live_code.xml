<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ============ Slim header (back arrow + centered title) ============ -->
    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:paddingTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/headerBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:tint="@color/text_primary"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="44dp"
            android:text="@string/livecode_title"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            android:gravity="center"/>
    </LinearLayout>

    <!-- ============ Segmented toggle: Preview | Code ============ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/toggleCard"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="#20FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/headerRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="4dp"
            android:weightSum="2">

            <TextView
                android:id="@+id/togglePreview"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="👁  Preview"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/toggleCode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="&lt;&gt;  Code"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="@drawable/toggle_tab_active"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ============ Content area (Code OR Preview) ============ -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/toggleCard"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ─── Code card ─── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/codeCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- File tab -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:background="#08FFFFFF">

                    <TextView
                        android:id="@+id/fileName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="file.txt"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/ic_file"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/accent"/>

                    <ImageButton
                        android:id="@+id/renameBtn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_pencil"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Rename"
                        app:tint="@color/text_secondary"/>

                    <ImageButton
                        android:id="@+id/moreBtn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_more"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="More"
                        app:tint="@color/text_secondary"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#12FFFFFF"/>

                <!-- The code editor itself -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:scrollbars="vertical">
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fillViewport="true">
                        <com.inweb.app.ui.editor.CodeEditorView
                            android:id="@+id/editor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="1000dp"
                            android:background="@color/surface"
                            android:textColor="@color/text_primary"
                            android:textCursorDrawable="@null"
                            android:gravity="top|start"
                            android:padding="14dp"
                            android:inputType="textMultiLine|textNoSuggestions|textVisiblePassword"
                            android:hint="…"
                            android:textColorHint="@color/text_secondary"
                            android:importantForAutofill="no"/>
                    </HorizontalScrollView>
                </ScrollView>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#08FFFFFF"
                    android:padding="8dp"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ─── Preview card ─── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/previewCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">
            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"/>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/inweb_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
