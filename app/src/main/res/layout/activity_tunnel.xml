<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <include
        android:id="@+id/header"
        layout="@layout/inweb_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>

            <!-- Provider picker -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tunnel_provider"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:letterSpacing="0.08"/>

                    <RadioGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton
                            android:id="@+id/providerCf"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tunnel_provider_cf"
                            android:textColor="@color/text_primary"/>
                        <RadioButton
                            android:id="@+id/providerNgrok"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tunnel_provider_ngrok"
                            android:textColor="@color/text_primary"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Status -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:text="@string/tunnel_stopped"
                android:textColor="@color/status_stopped"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <!-- Start / Stop buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/startBtn"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/start"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@color/btn_start"/>
                <Button
                    android:id="@+id/stopBtn"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/stop"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@color/btn_stop"/>
            </LinearLayout>

            <!-- Public URL card + QR -->
            <androidx.cardview.widget.CardView
                android:id="@+id/urlCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/qrImage"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:contentDescription="Public URL QR"
                        android:scaleType="fitCenter"/>

                    <TextView
                        android:id="@+id/urlText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="https://xxx.trycloudflare.com"
                        android:fontFamily="monospace"
                        android:textColor="#0B1410"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginTop="12dp">
                        <Button
                            android:id="@+id/copyBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="@string/copy"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="@color/surface"/>
                        <Button
                            android:id="@+id/shareBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            android:text="@string/share_url_btn"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="@color/accent"/>
                        <Button
                            android:id="@+id/openBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="@string/fw_open"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="@color/surface"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="12dp"
                android:text="@string/tunnel_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/inweb_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
