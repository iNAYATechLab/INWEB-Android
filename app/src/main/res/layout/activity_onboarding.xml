<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="24dp">

    <!-- Skip -->
    <Button
        android:id="@+id/skipBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="@string/onboard_skip"
        android:textColor="@color/text_secondary"
        android:background="@android:color/transparent"/>

    <!-- Icon + text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/stepIcon"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="@null"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:id="@+id/stepTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textAlignment="center"/>

        <TextView
            android:id="@+id/stepBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center"
            android:textAlignment="center"/>
    </LinearLayout>

    <!-- Progress dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp">

        <View android:id="@+id/dot1"
              android:layout_width="24dp" android:layout_height="4dp"
              android:layout_margin="4dp"/>
        <View android:id="@+id/dot2"
              android:layout_width="24dp" android:layout_height="4dp"
              android:layout_margin="4dp"/>
        <View android:id="@+id/dot3"
              android:layout_width="24dp" android:layout_height="4dp"
              android:layout_margin="4dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/nextBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/onboard_next"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:backgroundTint="@color/accent"/>
</LinearLayout>
