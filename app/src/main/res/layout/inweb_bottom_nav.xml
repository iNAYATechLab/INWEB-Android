<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared 5-tab bottom nav. Include with:
    <include android:id="@+id/bottomNav" layout="@layout/inweb_bottom_nav"
             android:layout_width="match_parent" android:layout_height="wrap_content"
             app:layout_constraintBottom_toBottomOf="parent"/>
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:background="@color/surface"
    android:weightSum="5"
    android:elevation="8dp">

    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/navHomeIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_home"
            android:contentDescription="@null"
            app:tint="@color/text_secondary"/>
        <TextView
            android:id="@+id/navHomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_home"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navServices"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/navServicesIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_services"
            android:contentDescription="@null"
            app:tint="@color/text_secondary"/>
        <TextView
            android:id="@+id/navServicesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_services"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navLogs"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/navLogsIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_logs"
            android:contentDescription="@null"
            app:tint="@color/text_secondary"/>
        <TextView
            android:id="@+id/navLogsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_logs"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navShare"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/navShareIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_qr"
            android:contentDescription="@null"
            app:tint="@color/text_secondary"/>
        <TextView
            android:id="@+id/navShareLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_share"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navMore"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/navMoreIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_more"
            android:contentDescription="@null"
            app:tint="@color/text_secondary"/>
        <TextView
            android:id="@+id/navMoreLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_more"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
</LinearLayout>
