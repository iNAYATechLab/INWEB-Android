<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Public web root lives under app-specific external storage. -->
    <external-files-path name="www"    path="www/"/>
    <external-files-path name="ext_all" path="."/>
    <!-- For sharing files from filesDir (rarely used). -->
    <files-path name="internal" path="."/>
    <!-- QR code images generated on demand. -->
    <cache-path name="share" path="share/"/>
</paths>
