<?xml version="1.0" encoding="utf-8"?>
<!--
  🔓 INWEB = লোকাল ওয়েব সার্ভার, তাই cleartext HTTP অ্যালাউ করতেই হবে।

  কেন আগের ফাইলটা ভুল ছিল (মাপা, beta.13): এখানে শুধু
  `localhost · 127.0.0.1 · 10.0.0.0 · 172.16.0.0 · 192.168.0.0` লিষ্ট করা ছিল,
  কিন্তু network security config-এর <domain> **হোস্টনেম ম্যাচ করে, IP রেঞ্জ না**।
  ফলে ফোনের আসল LAN IP `10.80.249.86` ম্যাপ করত না → WebView-তে
  `net::ERR_CLEARTEXT_NOT_PERMITTED` (স্ক্রিনশটে হুবহু এটাই ছিল),
  এবং http:// সাইট (google.com redirect ইত্যাদি) also ব্লক।
-->
<network-security-config>
    <!-- পুরো অ্যাপের জন্য cleartext চালু: ইনস্টল করা সার্ভার, LAN IP, http://
         সাইট প্রিভিউ — সব এতেই পড়ে। হার্ডওয়্যার/নেটওয়ার্ক স্নিফিংয়ের ঝুঁকি
         ব্যবহারকারীর নিজস্ব লোকাল নেটওয়ার্কেই সীমাবদ্ধ। -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- চাইলে অ্যালাউ করার পরও সাবডোমেইন/হোস্ট কেসে নিশ্চিত থাকার জন্য -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">.localtest.me</domain>
        <domain includeSubdomains="true">.local</domain>
    </domain-config>
</network-security-config>
