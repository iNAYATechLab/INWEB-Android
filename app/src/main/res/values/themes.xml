<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.INWEB" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Android 15 (SDK 35) enforces edge-to-edge → header dives UNDER the
             status bar. Opt out so our classic layouts keep proper insets. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <!--
      Base namespace style — empty, but REQUIRED so that dot-notation
      children like "INWEB.SectionLabel" can implicitly inherit from it.
      Without this base, AAPT fails with:
        error: resource style/INWEB (aka com.inweb.app:style/INWEB) not found.
    -->
    <style name="INWEB" />

    <!-- Small letter-spaced ALL-CAPS label above every section. -->
    <style name="INWEB.SectionLabel">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- Standard card container. -->
    <style name="INWEB.Card" parent="CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Consistent list-row container inside a card. -->
    <style name="INWEB.CardRow">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Primary bold title text used on cards. -->
    <style name="INWEB.CardTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Secondary meta text (monospace, muted) used on cards. -->
    <style name="INWEB.CardMeta">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- Primary accent CTA button. -->
    <style name="INWEB.ButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="INWEB.ButtonSecondary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="cornerRadius">10dp</item>
    </style>
</resources>

