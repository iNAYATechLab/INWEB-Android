# Rendered at first-run by AssetInstaller — placeholders are replaced with
# real absolute paths / ports before nginx sees this file.
#
# Placeholders: __PREFIX__ __BINDIR__ __CONFDIR__ __LOGDIR__ __TMPDIR__
#               __DOCROOT__ __PORT__ __PHP_FPM__

worker_processes  1;
error_log  __LOGDIR__/error.log warn;
pid        __TMPDIR__/nginx.pid;

events {
    worker_connections  256;
}

http {
    # ─── Security: rate-limit zone (injected by INWEB) ──────────────
    __SEC_HTTP_BLOCK__

    default_type  application/octet-stream;

    # MIME types – keep the file next to nginx.conf if you have one; otherwise
    # this minimal set covers the common cases.
    types {
        text/html                             html htm;
        text/css                              css;
        application/javascript                js;
        image/png                             png;
        image/jpeg                            jpg jpeg;
        image/svg+xml                         svg;
        application/json                      json;
    }

    sendfile        on;
    keepalive_timeout  65;

    client_body_temp_path  __TMPDIR__/client_body;
    proxy_temp_path        __TMPDIR__/proxy;
    fastcgi_temp_path      __TMPDIR__/fastcgi;
    uwsgi_temp_path        __TMPDIR__/uwsgi;
    scgi_temp_path         __TMPDIR__/scgi;

    access_log __LOGDIR__/access.log;

    server {
        # __BIND__ is "127.0.0.1" (localhost only) or "0.0.0.0" (LAN accessible)
        listen       __BIND__:__PORT__ default_server;
        server_name  localhost;

        # HTTPS listener — the placeholder line below becomes a real
        # `listen … ssl;` when Prefs.httpsEnabled is on. If off, the
        # template renderer replaces the whole line with a `#` comment
        # so the server keeps working over plain HTTP only.
        __HTTPS_LISTEN__
        __HTTPS_CERT__
        __HTTPS_KEY__

        root  __DOCROOT__;
        index index.php index.html index.htm;

        # ─── Security: IP allow/deny + rate limit (injected) ────────
        __SEC_SERVER_TOP__

        location / {
            # ─── Security: basic auth (injected) ────────────────────
            __SEC_LOCATION_ROOT__

            # ─── LiveReload: inject client script before </body> ────
            __LIVE_RELOAD_INJECT__

            try_files $uri $uri/ /index.php?$query_string;
        }

        # ─── LiveReload: serve the client JS from our assets ────────
        location = /__inweb_livereload.js {
            alias __LIVE_RELOAD_JS__;
            default_type application/javascript;
            add_header Cache-Control "no-store";
        }

        # phpMyAdmin — friendlier routing so /phpmyadmin/ works without
        # a trailing slash and directory index resolves.
        location /phpmyadmin/ {
            index index.php index.html;
            try_files $uri $uri/ /phpmyadmin/index.php?$query_string;
        }

        location ~ \.php$ {
            # (default server) — vhost server blocks below add extra PHP handlers
            fastcgi_pass   __PHP_FPM__;
            fastcgi_index  index.php;
            fastcgi_param  SCRIPT_FILENAME  $document_root$fastcgi_script_name;
            fastcgi_param  QUERY_STRING     $query_string;
            fastcgi_param  REQUEST_METHOD   $request_method;
            fastcgi_param  CONTENT_TYPE     $content_type;
            fastcgi_param  CONTENT_LENGTH   $content_length;
            fastcgi_param  REQUEST_URI      $request_uri;
            fastcgi_param  DOCUMENT_URI     $document_uri;
            fastcgi_param  DOCUMENT_ROOT    $document_root;
            fastcgi_param  SERVER_PROTOCOL  $server_protocol;
            fastcgi_param  REMOTE_ADDR      $remote_addr;
            fastcgi_param  SERVER_ADDR      $server_addr;
            fastcgi_param  SERVER_PORT      $server_port;
            fastcgi_param  SERVER_NAME      $server_name;
        }
    }

    # ─── User-defined virtual hosts (injected by NginxVHostRenderer) ───
    __VHOSTS__
}
