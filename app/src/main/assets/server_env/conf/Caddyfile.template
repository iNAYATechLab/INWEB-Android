# INWEB — Caddyfile
# Rendered at first-run by AssetInstaller.
#
# Placeholders:  __BIND__ __PORT__ __DOCROOT__ __PHP_FPM__
#                __LOGDIR__ __TMPDIR__
#
# Caddy is delightful — a single binary, tiny config, and automatic HTTPS
# for any real domain. For local development we bind to the port the user
# chose in Settings.

{
    # global options
    admin off
    persist_config off
    log {
        output file __LOGDIR__/caddy.log
        format console
    }
    storage file_system {
        root __TMPDIR__/caddy
    }
}

# Main site
:__PORT__ {
    root * __DOCROOT__

    # PHP → PHP-FPM (identical socket to Nginx/Apache)
    php_fastcgi __PHP_FPM__

    # Static files
    file_server {
        index index.php index.html index.htm
    }

    # Friendlier logging
    log {
        output file __LOGDIR__/caddy_access.log
    }

    # Try /index.php for pretty URLs (Laravel / WordPress style)
    @notFile {
        not file
        not path /phpmyadmin/*
    }
    rewrite @notFile /index.php?{query}

    # Common asset caching
    @static {
        path *.css *.js *.png *.jpg *.jpeg *.gif *.svg *.woff *.woff2 *.ico
    }
    header @static Cache-Control "public, max-age=604800"
}
