# INWEB — Apache HTTP Server configuration
# Rendered at first-run by AssetInstaller. Placeholders replaced with real
# absolute paths + the ports/bind-mode/php-fpm address chosen in Settings.
#
# Placeholders:
#   __PREFIX__ __BINDIR__ __CONFDIR__ __LOGDIR__ __TMPDIR__
#   __DOCROOT__ __PORT__ __BIND__ __PHP_FPM__
#   __APACHE_SERVERROOT__ __APACHE_MODULES__ __APACHE_LOGDIR__
#   __HTTPS_LISTEN__ __HTTPS_CERT__ __HTTPS_KEY__

ServerRoot   "__APACHE_SERVERROOT__"
ServerName   localhost
Listen       __BIND__:__PORT__
PidFile      "__TMPDIR__/httpd.pid"
DefaultRuntimeDir "__TMPDIR__/apache"

# --- Core modules (paths supplied by Termux-style build) -------------------
LoadModule mpm_event_module        __APACHE_MODULES__/mod_mpm_event.so
LoadModule authn_file_module       __APACHE_MODULES__/mod_authn_file.so
LoadModule authn_core_module       __APACHE_MODULES__/mod_authn_core.so
LoadModule authz_host_module       __APACHE_MODULES__/mod_authz_host.so
LoadModule authz_user_module       __APACHE_MODULES__/mod_authz_user.so
LoadModule authz_core_module       __APACHE_MODULES__/mod_authz_core.so
LoadModule access_compat_module    __APACHE_MODULES__/mod_access_compat.so
LoadModule auth_basic_module       __APACHE_MODULES__/mod_auth_basic.so
LoadModule reqtimeout_module       __APACHE_MODULES__/mod_reqtimeout.so
LoadModule filter_module           __APACHE_MODULES__/mod_filter.so
LoadModule mime_module             __APACHE_MODULES__/mod_mime.so
LoadModule log_config_module       __APACHE_MODULES__/mod_log_config.so
LoadModule env_module              __APACHE_MODULES__/mod_env.so
LoadModule headers_module          __APACHE_MODULES__/mod_headers.so
LoadModule setenvif_module         __APACHE_MODULES__/mod_setenvif.so
LoadModule version_module          __APACHE_MODULES__/mod_version.so
LoadModule unixd_module            __APACHE_MODULES__/mod_unixd.so
LoadModule status_module           __APACHE_MODULES__/mod_status.so
LoadModule autoindex_module        __APACHE_MODULES__/mod_autoindex.so
LoadModule dir_module              __APACHE_MODULES__/mod_dir.so
LoadModule alias_module            __APACHE_MODULES__/mod_alias.so
LoadModule rewrite_module          __APACHE_MODULES__/mod_rewrite.so
LoadModule proxy_module            __APACHE_MODULES__/mod_proxy.so
LoadModule proxy_fcgi_module       __APACHE_MODULES__/mod_proxy_fcgi.so

# TLS is loaded only when HTTPS is on; the templater will comment these out.
__HTTPS_LISTEN__

<IfModule unixd_module>
    # Termux ships httpd without System-V users, so leave User/Group unset.
</IfModule>

# --- MIME types -------------------------------------------------------------
TypesConfig conf/mime.types
<IfModule mime_module>
    AddType application/x-httpd-php  .php
    AddType text/html                .html .htm
    AddType text/css                 .css
    AddType application/javascript   .js
</IfModule>

# --- Logging ---------------------------------------------------------------
ErrorLog    "__LOGDIR__/apache_error.log"
LogLevel    warn
LogFormat   "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined
CustomLog   "__LOGDIR__/apache_access.log" combined

# --- Document root ---------------------------------------------------------
DocumentRoot "__DOCROOT__"

<Directory />
    AllowOverride none
    Require all denied
</Directory>

<Directory "__DOCROOT__">
    Options Indexes FollowSymLinks
    AllowOverride All
    Require all granted
</Directory>

DirectoryIndex index.php index.html index.htm

# --- PHP-FPM via FastCGI proxy --------------------------------------------
<FilesMatch \.php$>
    SetHandler "proxy:fcgi://__PHP_FPM__"
</FilesMatch>

# --- Optional HTTPS virtual host ------------------------------------------
__HTTPS_CERT__
__HTTPS_KEY__

# --- Suppress "Could not reliably determine server name" warning ----------
ServerTokens Prod
ServerSignature Off
