; Rendered at first-run by AssetInstaller.
; Placeholders: __PREFIX__ __LOGDIR__ __TMPDIR__ __PHP_FPM__

[global]
pid = __TMPDIR__/php-fpm.pid
error_log = __LOGDIR__/php-fpm.error.log
daemonize = no

[www]
listen = __PHP_FPM__
listen.backlog = 128

; No unix user on Android – run as the app's UID (default).
;user  = nobody
;group = nobody

pm                      = dynamic
pm.max_children         = 5
pm.start_servers        = 1
pm.min_spare_servers    = 1
pm.max_spare_servers    = 3
pm.max_requests         = 500

catch_workers_output = yes
